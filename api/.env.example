# Copie para api/.env para rodar a API no seu PC ("npm run dev").
# No Railway estas variáveis vão em Variables do serviço da API.

# Postgres. No Railway use a referência: ${{Postgres.DATABASE_URL}}
# Local: a URL pública do Postgres do Railway (aba Connect → Public Network)
# ou um Postgres instalado na máquina.
DATABASE_URL=postgres://postgres:senha@localhost:5432/scanmercado

# Segredo que assina os tokens de login (mínimo 32 caracteres, aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Admin principal — criado no primeiro boot se ainda não existir.
ADMIN_EMAIL=voce@scanmercado.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Equipe ScanMercado

# Opcional
# PORT=3000
# SESSION_DAYS=30
# Origens liberadas no navegador (painel web), separadas por vírgula. Vazio = todas.
# CORS_ORIGINS=https://admin.seudominio.com.br
# Cliente de teste (CPF 12345678900 / senha 123456) na franquia piloto. Só em teste.
# SEED_DEMO_CUSTOMER=true
