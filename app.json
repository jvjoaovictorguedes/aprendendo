{
  "expo": {
    "name": "Bipou",
    "description": "Bipou, somou e comprou. Bipe os produtos no mercado e veja o total antes do caixa.",
    "slug": "scanmercado",
    "scheme": "scanmercado",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera para ler o código de barras dos produtos."
      }
    },
    "android": {
      "package": "com.scanmercado.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera para ler o código de barras dos produtos."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecione a logo do mercado para personalizar o aplicativo.",
          "cameraPermission": "Precisamos da câmera para ler o código de barras dos produtos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/3aaa6cfc-feb2-4f05-9def-8cfed74ce8c5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "3aaa6cfc-feb2-4f05-9def-8cfed74ce8c5"
      }
    },
    "owner": "jvjoaovictorguedes"
  }
}
