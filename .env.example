# Copie este arquivo para ".env" (ou ".env.local") e preencha com os dados
# do seu projeto Supabase: Project Settings > API.
#
# Variáveis EXPO_PUBLIC_* ficam embutidas no app (não são segredo de servidor,
# a proteção de dados é feita por Row Level Security no banco). Sem esses
# valores, o app funciona normalmente usando o catálogo local de exemplo
# (src/data/products.ts).

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# UUID da franquia (tenant) que este build representa — veja a tabela
# "tenants" no SCHEMA.sql. A piloto interna já vem com este id:
EXPO_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
